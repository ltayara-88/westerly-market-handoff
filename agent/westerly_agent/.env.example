# Local runs only; on Heroku set these as config vars. Never commit .env.
GOOGLE_API_KEY=""
# Any long random string; the site app's AGENT_SHARED_SECRET must match.
AGENT_SHARED_SECRET=""
# Salesforce External Client App (client credentials flow) for support cases; SF_DOMAIN is the My Domain host, no https://.
SF_DOMAIN=""
SF_CLIENT_ID=""
SF_CLIENT_SECRET=""
