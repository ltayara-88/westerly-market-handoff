<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Not_Found_Message</name>
        <label>Set Not Found Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>We couldn&apos;t find that order number. Please check it and try again.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Not_Verified_Message</name>
        <label>Set Not Verified Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>That email doesn&apos;t match this order. Please check both and try again.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Order_Details</name>
        <label>Set Order Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isVerified</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>orderStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>foundStatus</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>orderDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>foundDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>orderTotal</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>foundTotal</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>message</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Order verified.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Email_matches</name>
        <label>Email matches?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Verified_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Verified</defaultConnectorLabel>
        <rules>
            <name>Verified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>foundEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Order_Details</targetReference>
            </connector>
            <label>Verified</label>
        </rules>
    </decisions>
    <decisions>
        <name>Order_is_found</name>
        <label>Order is found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Found_Message</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not found</defaultConnectorLabel>
        <rules>
            <name>Order_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>foundCustomerId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Email</targetReference>
            </connector>
            <label>Order is Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Westerly – Get Order Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Westerly – Get Order Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Email</name>
        <label>Get Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Email_matches</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ssot__PartyId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>foundCustomerId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ssot__EmailAddress__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>customerEmail</elementReference>
            </value>
        </filters>
        <object>ssot__ContactPointEmail__dlm</object>
        <outputAssignments>
            <assignToReference>foundEmail</assignToReference>
            <field>ssot__EmailAddress__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Order</name>
        <label>Get Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Order_is_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ssot__Id__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>orderNumber</elementReference>
            </value>
        </filters>
        <object>ssot__SalesOrder__dlm</object>
        <outputAssignments>
            <assignToReference>foundTotal</assignToReference>
            <field>ssot__GrandTotalAmount__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>foundDate</assignToReference>
            <field>ssot__OrderStartDate__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>foundStatus</assignToReference>
            <field>ssot__SalesOrderStatusId__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>foundCustomerId</assignToReference>
            <field>ssot__SoldToCustomerId__c</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Order</targetReference>
        </connector>
    </start>
    <status>Active</status>
