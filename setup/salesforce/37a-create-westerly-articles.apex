// Creates the 7 Westerly Market help-center articles (FAQ record type; internal app only, which is always on: customer, partner and public visibility off) as drafts.
// Generated from 36-westerly-knowledge-articles.md. Publish afterwards with 37b-publish-westerly-articles.apex.
Id faq = [SELECT Id FROM RecordType WHERE SobjectType = 'Knowledge__kav' AND DeveloperName = 'SDO_Knowledge_FAQ'].Id;
List<Knowledge__kav> articles = new List<Knowledge__kav>();
articles.add(new Knowledge__kav(RecordTypeId = faq, Language = 'en_US', Title = 'Can I add items to an order I already placed?', UrlName = 'westerly-add-items-to-an-order',
    Summary = 'You can add items while the order is "Not yet picked". After that, place a new order or add the items to your next one.', FAQ_Question__c = 'Can I add items to an order I already placed?', Chat_Answer__c = 'Yes, as long as your order shows "Not yet picked". Once it\'s picked or delivered we can\'t add to it, but you can place a new order or add the items to your next one.',
    FAQ_Answer__c = '<p>You can add items to an order until our team starts picking it.</p><ul><li><strong>Not yet picked:</strong> contact Westerly Support with your order number and the items you want. We add them to the same order and delivery or pickup time, and your total is updated before you\'re charged.</li><li><strong>Picked:</strong> your groceries are already bagged, so we can\'t add to this order. Place a new order (free curbside pickup over $35), or tell us and we\'ll note the items for your next order.</li><li><strong>Delivered:</strong> place a new order, or add the items to your next one.</li></ul><p>Added items are subject to what\'s in stock. If an item is out, we\'ll suggest a substitute.</p>',
    FAQ_Internal_Comments__c = '<ol><li>Check the order status in the Westerly Shopper panel on the case.</li><li><strong>Not yet picked:</strong> add the item to the same order, confirm the item, size and price with the shopper, and reply with the new total. No payment details are needed; the card on file is charged at pickup or delivery.</li><li><strong>Picked or Delivered:</strong> don\'t reopen the order. Offer a new order, or add a note to the shopper\'s profile so the item goes on their next order.</li><li>Never ask for card numbers in a case or chat.</li></ol>',
    Article_Confidence__c = 'Validated', IsVisibleInCsp = false, IsVisibleInPkb = false, IsVisibleInPrm = false));
articles.add(new Knowledge__kav(RecordTypeId = faq, Language = 'en_US', Title = 'How do I remove an item or cancel my order?', UrlName = 'westerly-remove-items-or-cancel',
    Summary = 'Remove items or cancel any time before the order is picked.', FAQ_Question__c = 'How do I remove an item or cancel my order?', Chat_Answer__c = 'You can remove items or cancel any time before your order is picked. After it\'s picked, you can still return unwanted items within 30 days for a full refund.',
    FAQ_Answer__c = '<p>Before your order is picked, contact Westerly Support to remove items or cancel. Nothing is charged for a canceled order. Once the order is picked, we can\'t change it. You can refuse an item at the door or curbside, or return it within 30 days for a full refund.</p>',
    FAQ_Internal_Comments__c = '<p>Cancel or edit only orders that are "Not yet picked". For picked orders, point the shopper to returns (article 6).</p><p>---</p><p>## Order in Progress</p>',
    Article_Confidence__c = 'Validated', IsVisibleInCsp = false, IsVisibleInPkb = false, IsVisibleInPrm = false));
articles.add(new Knowledge__kav(RecordTypeId = faq, Language = 'en_US', Title = 'What does my order status mean?', UrlName = 'westerly-order-status',
    Summary = '"Not yet picked", "Picked" and "Delivered", and what you can still change at each step.', FAQ_Question__c = 'What does my order status mean?', Chat_Answer__c = '"Not yet picked" means you can still add, remove or cancel. "Picked" means it\'s bagged and ready. "Delivered" means it\'s with you or was collected.',
    FAQ_Answer__c = '<table><tr><th>Status</th><th>What it means</th><th>What you can still change</th></tr><tr><td>Not yet picked</td><td>We have your order and haven\'t started shopping it</td><td>Add or remove items, change the time, cancel</td></tr><tr><td>Picked</td><td>Your groceries are bagged and waiting for delivery or pickup</td><td>Nothing on this order; start a new one</td></tr><tr><td>Delivered</td><td>Delivered to your door or collected curbside</td><td>Report a problem or return items</td></tr></table>',
    FAQ_Internal_Comments__c = '<p>The status in the Westerly Shopper panel comes from Data 360 and decides which actions are allowed. When in doubt, treat the order as picked.</p>',
    Article_Confidence__c = 'Validated', IsVisibleInCsp = false, IsVisibleInPkb = false, IsVisibleInPrm = false));
articles.add(new Knowledge__kav(RecordTypeId = faq, Language = 'en_US', Title = 'What happens if an item is out of stock?', UrlName = 'westerly-substitutions',
    Summary = 'We pick the closest match at the same or lower price, or refund the item.', FAQ_Question__c = 'What happens if an item is out of stock?', Chat_Answer__c = 'We\'ll pick the closest match at the same price or lower. If there isn\'t a good match, we leave it out and you\'re not charged for it.',
    FAQ_Answer__c = '<p>If something you ordered is out of stock, our team picks the closest match: same brand in a different size, or a similar product. A substitute never costs more than the original item. If there\'s no good match, we leave it out and you aren\'t charged. Don\'t want a substitute? Refuse it at delivery or pickup and we\'ll refund it.</p>',
    FAQ_Internal_Comments__c = '<p>If a shopper is unhappy with a substitute, refund the item; no return is needed for perishables.</p><p>---</p><p>## Delivery &amp; Pickup</p>',
    Article_Confidence__c = 'Validated', IsVisibleInCsp = false, IsVisibleInPkb = false, IsVisibleInPrm = false));
articles.add(new Knowledge__kav(RecordTypeId = faq, Language = 'en_US', Title = 'How do delivery and curbside pickup work?', UrlName = 'westerly-delivery-and-pickup',
    Summary = 'Same-day home delivery within 10 miles; free curbside pickup on orders over $35.', FAQ_Question__c = 'How do delivery and curbside pickup work?', Chat_Answer__c = 'We offer same-day home delivery within 10 miles of the store, and curbside pickup that\'s free on orders over $35. Choose a time at checkout.',
    FAQ_Answer__c = '<ul><li><strong>Home delivery:</strong> same-day, within 10 miles of the store. Choose a delivery window at checkout.</li><li><strong>Curbside pickup:</strong> free on orders over $35. Choose a pickup time at checkout, park in a curbside spot, and we\'ll bring your order out.</li></ul><p>Need a different time? Contact us before your order is picked.</p>',
    FAQ_Internal_Comments__c = '<p>Time changes follow the same rule as item changes: only while "Not yet picked".</p>',
    Article_Confidence__c = 'Validated', IsVisibleInCsp = false, IsVisibleInPkb = false, IsVisibleInPrm = false));
articles.add(new Knowledge__kav(RecordTypeId = faq, Language = 'en_US', Title = 'An item is missing, damaged or wrong. What do I do?', UrlName = 'westerly-missing-or-damaged-items',
    Summary = 'Tell us within 30 days and we\'ll refund or replace the item.', FAQ_Question__c = 'An item is missing, damaged or wrong. What do I do?', Chat_Answer__c = 'Sorry about that! Tell us which item and your order number within 30 days and we\'ll refund it or send a replacement with your next order.',
    FAQ_Answer__c = '<p>Contact Westerly Support with your order number and the item. Within 30 days of delivery or pickup we\'ll refund the item or add a free replacement to your next order. For damaged or spoiled food you don\'t need to bring it back.</p>',
    FAQ_Internal_Comments__c = '<p>Refund to the original payment method; don\'t ask for card details.</p><p>---</p><p>## Refunds &amp; Returns</p>',
    Article_Confidence__c = 'Validated', IsVisibleInCsp = false, IsVisibleInPkb = false, IsVisibleInPrm = false));
articles.add(new Knowledge__kav(RecordTypeId = faq, Language = 'en_US', Title = 'How do returns and refunds work?', UrlName = 'westerly-returns-and-refunds',
    Summary = 'Return any item within 30 days for a full refund to your original payment method.', FAQ_Question__c = 'How do returns and refunds work?', Chat_Answer__c = 'Not happy with an item? Return it within 30 days for a full refund. Refunds go back to your original payment method.',
    FAQ_Answer__c = '<p>Bring the item back to the store, or tell us at your next delivery or pickup, within 30 days. We refund the full item price to your original payment method. Refunds usually show up in 3–5 business days, depending on your bank.</p>',
    FAQ_Internal_Comments__c = '<p>Refunds always go to the original payment method. Never take payment details in a case.</p>',
    Article_Confidence__c = 'Validated', IsVisibleInCsp = false, IsVisibleInPkb = false, IsVisibleInPrm = false));
insert articles;
for (Knowledge__kav k : articles) System.debug('Created draft ' + k.UrlName);
