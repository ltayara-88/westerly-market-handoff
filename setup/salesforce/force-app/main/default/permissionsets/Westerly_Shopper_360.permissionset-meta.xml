<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Westerly Shopper 360</label>
    <description>Shows the Westerly Shopper 360 tab and lets its components call WesterlyShopperCardController, and gives access to the Westerly Case fields.</description>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Westerly_Customer_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Westerly_Order_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.Westerly_Order_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Westerly_Customer_Id__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>WesterlyShopperCardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <tabSettings>
        <tab>Westerly_Shopper_360</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
