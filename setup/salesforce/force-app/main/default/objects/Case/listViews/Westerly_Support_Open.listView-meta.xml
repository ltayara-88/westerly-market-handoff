<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Westerly_Support_Open</fullName>
    <label>Westerly - Open Cases</label>
    <!-- Every open case the Google agent created, whoever owns it: the demo org's Case routing reassigns new cases. -->
    <filterScope>Everything</filterScope>
    <booleanFilter>1 AND 2</booleanFilter>
    <filters>
        <field>CASES.CLOSED</field>
        <operation>equals</operation>
        <value>0</value>
    </filters>
    <filters>
        <field>Westerly_Customer_Id__c</field>
        <operation>notEqual</operation>
    </filters>
    <columns>CASES.CASE_NUMBER</columns>
    <columns>NAME</columns>
    <columns>CASES.SUBJECT</columns>
    <columns>Westerly_Order_Id__c</columns>
    <columns>CASES.STATUS</columns>
    <columns>OWNER_NAME</columns>
    <columns>CASES.CREATED_DATE_DATE_ONLY</columns>
</ListView>
